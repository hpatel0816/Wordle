# Copy to .env.local and fill in. Online play is hidden when these are empty.
# Local: run `npm run db:start`, then copy API_URL and ANON_KEY from `npx supabase status`.
# Hosted: Project Settings > API in the Supabase dashboard. Use the anon key only,
# never the service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
